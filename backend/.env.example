# FarmerAssist backend — copy to backend/.env (never commit .env). See SETUP_CREDENTIALS.md.
# Render: set these in the service's Environment tab instead (see render.yaml).

ENVIRONMENT=development          # production on Render (disables /docs, forbids "*" CORS)
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true only behind a trusted proxy (Render) — makes rate limits per client instead of per proxy
TRUST_PROXY_HEADERS=false

# Supabase (Project Settings → API Keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret key: backend only. Bypasses Row Level Security — never put it in the frontend or in git.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_NAME=farmer-images

# Server-side rate limits (SlowAPI syntax)
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_IMAGE=5/minute
RATE_LIMIT_VOICE=5/minute

# AI guardrails
RETRIEVAL_SIMILARITY_THRESHOLD=0.61
IMAGE_CONFIDENCE_THRESHOLD=0.60

# Voice (faster-whisper, ~1 GB RAM). Install requirements-voice.txt, then set true.
VOICE_ENABLED=false
VOICE_MODEL_SIZE=small

# Login (single demo account; server-side auth). Generate both values with:
#   backend/.venv/Scripts/python scripts/hash_password.py
# The password itself is NEVER stored — only its PBKDF2-SHA256 hash. Empty = login disabled (API returns 503).
DEMO_USERNAME=
DEMO_PASSWORD_HASH=
# Random 48+ char string that signs session tokens. Changing it logs everyone out.
SESSION_SECRET=
SESSION_TTL_HOURS=12
RATE_LIMIT_LOGIN=5/minute
