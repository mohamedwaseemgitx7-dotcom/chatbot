# FarmerAssist frontend — copy to frontend/.env (never commit .env).
# Only PUBLIC values belong here: everything VITE_* is bundled into the browser JavaScript.
# Vercel: set these in Project → Settings → Environment Variables.

# Backend URL. Leave empty in local dev (Vite proxies /api to BACKEND_PROXY_TARGET).
# Production: https://<your-render-service>.onrender.com
VITE_API_BASE_URL=

# Supabase project URL + publishable (anon) key. NEVER the secret / service-role key.
# Leave empty to keep conversations in this browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# false = demo mode (local greeting replies, no backend)
VITE_USE_BACKEND=true

# Dev server only (not exposed to the browser)
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
